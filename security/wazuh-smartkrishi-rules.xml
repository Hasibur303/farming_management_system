<group name="smartkrishi,">
  <rule id="100100" level="5">
    <decoded_as>json</decoded_as>
    <field name="application" type="pcre2">^smartkrishi$</field>
    <description>SmartKrishi security event: $(event)</description>
    <group>smartkrishi_event,</group>
  </rule>

  <rule id="100101" level="7">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^authentication\.login_failed$</field>
    <description>SmartKrishi failed login from $(ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100103" level="9">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^authentication\.rate_limited$</field>
    <description>SmartKrishi login rate limit triggered from $(ip)</description>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <rule id="100104" level="8">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^csrf\.</field>
    <description>SmartKrishi CSRF protection event from $(ip): $(event)</description>
    <group>csrf,web_attack,</group>
  </rule>

  <rule id="100105" level="7">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^(authorization\.|access\.)</field>
    <description>SmartKrishi unauthorized access event from $(ip): $(event)</description>
    <group>access_denied,</group>
  </rule>

  <rule id="100106" level="12">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^(upload\.(malware|infected)|malware\.)</field>
    <description>SmartKrishi malware or infected upload detected: $(event)</description>
    <group>malware,virus,</group>
  </rule>

  <rule id="100107" level="8">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^(activity\.|suspicious\.)</field>
    <description>SmartKrishi suspicious activity detected: $(event)</description>
    <group>anomaly,</group>
  </rule>
</group>
