# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farming_management
DB_USER=root
DB_PASSWORD=

# Security integrations
# Full path to clamscan.exe on Windows. Leave blank to auto-detect common paths.
CLAMAV_PATH=
# Set true in production to reject uploads when ClamAV is unavailable.
CLAMAV_REQUIRED=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
MFA_ENCRYPTION_KEY=
MFA_MAX_ATTEMPTS=5
MFA_WINDOW_MINUTES=10

# Kindwise crop and insect identification APIs
KINDWISE_API_KEY=
KINDWISE_ENDPOINT=https://crop.kindwise.com/api/v1/identification
INSECT_API_KEY=
INSECT_ENDPOINT=https://insect.kindwise.com/api/v1/identification
